{
  "name": "\u05e9\u05dc\u05d9\u05d7\u05ea \u05de\u05d9\u05d9\u05dc \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05d1\u05d4\u05e9\u05dc\u05de\u05ea \u05e9\u05d0\u05dc\u05d5\u05df",
  "description": "\u05e9\u05d5\u05dc\u05d7 \u05de\u05d9\u05d9\u05dc \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05dc\u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05d9\u05d3 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e9\u05dc\u05de\u05ea \u05d4\u05e9\u05d0\u05dc\u05d5\u05df \u05e2\u05dd \u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e8\u05db\u05d9\u05e9\u05ea \u05d3\u05d5\u05d7",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "QuestionnaireResponse"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onQuestionnaireCompleted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onQuestionnaireCompleted"
  }
}