{
  "name": "ContentItem",
  "type": "object",
  "properties": {
    "page": {
      "type": "string",
      "enum": [
        "home",
        "about",
        "articles",
        "terms"
      ],
      "description": "\u05d4\u05e2\u05de\u05d5\u05d3 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05e9\u05d9\u05d9\u05da \u05d4\u05ea\u05d5\u05db\u05df"
    },
    "section": {
      "type": "string",
      "description": "\u05d4\u05e1\u05e7\u05e9\u05df \u05d1\u05e2\u05de\u05d5\u05d3 (\u05dc\u05de\u05e9\u05dc: hero, benefits, testimonials)"
    },
    "content_key": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05ea\u05d5\u05db\u05df (\u05dc\u05de\u05e9\u05dc: hero_title, hero_subtitle)"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "html"
      ],
      "default": "text",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05d5\u05db\u05df"
    },
    "content_he": {
      "type": "string",
      "description": "\u05d4\u05ea\u05d5\u05db\u05df \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea"
    },
    "content_en": {
      "type": "string",
      "description": "\u05d4\u05ea\u05d5\u05db\u05df \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05d4 \u05d4\u05ea\u05d5\u05db\u05df \u05de\u05d9\u05d9\u05e6\u05d2 (\u05dc\u05e2\u05d6\u05e8\u05d4 \u05dc\u05de\u05e0\u05d4\u05dc)"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05ea\u05e6\u05d5\u05d2\u05d4"
    }
  },
  "required": [
    "page",
    "section",
    "content_key",
    "content_type"
  ]
}