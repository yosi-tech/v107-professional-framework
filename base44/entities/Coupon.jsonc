{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d4\u05e7\u05d5\u05e4\u05d5\u05df \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9"
    },
    "discount_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05d4\u05e0\u05d7\u05d4 \u05d1\u05e9\u05e7\u05dc\u05d9\u05dd"
    },
    "discount_percentage": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05d4\u05e0\u05d7\u05d4 (\u05d0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9)"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d5\u05e7\u05e3 \u05d4\u05e7\u05d5\u05e4\u05d5\u05df"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e7\u05d5\u05e4\u05d5\u05df \u05db\u05d1\u05e8 \u05e0\u05d5\u05e6\u05dc"
    },
    "is_single_use": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e7\u05d5\u05e4\u05d5\u05df \u05d4\u05d5\u05d0 \u05d7\u05d3 \u05e4\u05e2\u05de\u05d9 \u05d0\u05d5 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05e8\u05d5\u05d1\u05d4"
    },
    "is_user_specific": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e7\u05d5\u05e4\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05dc \u05dc\u05de\u05e9\u05ea\u05de\u05e9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d0\u05d5 \u05e4\u05ea\u05d5\u05d7 \u05dc\u05db\u05d5\u05dc\u05dd"
    },
    "user_email": {
      "type": "string",
      "description": "\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05dc\u05d5 \u05e0\u05d5\u05e6\u05e8 \u05d4\u05e7\u05d5\u05e4\u05d5\u05df (\u05e8\u05e7 \u05d0\u05dd is_user_specific=true)"
    },
    "source": {
      "type": "string",
      "enum": [
        "abandonment_survey",
        "promotion",
        "referral"
      ],
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05e7\u05d5\u05e4\u05d5\u05df"
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}