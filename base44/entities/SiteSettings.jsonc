      "description": "\u05e2\u05e8\u05da \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
