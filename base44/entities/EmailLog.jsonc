{
  "name": "EmailLog",
  "type": "object",
  "properties": {
    "to_email": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05e0\u05de\u05e2\u05df"
    },
    "email_type": {
      "type": "string",
      "enum": [
        "full_report_purchase",
        "answers_download_purchase",
        "abandonment_survey",
        "report_ready",
        "consultation_request",
        "questionnaire_completion"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05e0\u05e9\u05dc\u05d7"
    },
    "subject": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05de\u05d9\u05d9\u05dc"
    },
    "related_user_email": {
      "type": "string",
      "description": "\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8"
    },
    "related_questionnaire_response_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05e9\u05d0\u05dc\u05d5\u05df \u05d4\u05de\u05e7\u05d5\u05e9\u05e8\u05ea"
    },
    "related_report_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05d3\u05d5\"\u05d7 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8"
    },
    "sent_manually": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d9\u05d9\u05dc \u05e0\u05e9\u05dc\u05d7 \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05d3\u05e0\u05d9 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05d3\u05de\u05d9\u05df"
    },
    "language": {
      "type": "string",
      "enum": [
        "he",
        "en"
      ],
      "default": "he"
    }
  },
  "required": [
    "to_email",
    "email_type",
    "subject"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}