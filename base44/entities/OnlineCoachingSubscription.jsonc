{
  "name": "OnlineCoachingSubscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05de\u05e0\u05d5\u05d9"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "questionnaire_response_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05ea\u05e9\u05d5\u05d1\u05ea \u05d4\u05e9\u05d0\u05dc\u05d5\u05df \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "generated_report_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05d3\u05d5\u05d7 \u05d4\u05de\u05dc\u05d0 \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05ea \u05d4\u05dc\u05d9\u05d5\u05d5\u05d9"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05d4\u05dc\u05d9\u05d5\u05d5\u05d9 (30 \u05d9\u05de\u05d9\u05dd \u05de\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d4\u05ea\u05d7\u05dc\u05d4)"
    },
    "current_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 1,
      "description": "\u05d4\u05d9\u05d5\u05dd \u05d4\u05e0\u05d5\u05db\u05d7\u05d9 \u05d1\u05dc\u05d9\u05d5\u05d5\u05d9 (1-30)"
    },
    "last_email_sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05dc\u05d9\u05d7\u05ea \u05d4\u05de\u05d9\u05d9\u05dc \u05d4\u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "cancelled",
        "upgraded"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05e0\u05d5\u05d9"
    },
    "language": {
      "type": "string",
      "enum": [
        "he",
        "en"
      ],
      "default": "he",
      "description": "\u05e9\u05e4\u05ea \u05d4\u05de\u05d9\u05d9\u05dc\u05d9\u05dd"
    },
    "recommended_booster_track": {
      "type": "string",
      "enum": [
        "resilience",
        "flexibility",
        "leadership",
        "communication",
        "planning",
        "learning",
        "vision",
        "technology",
        "networking",
        "balance",
        "change"
      ],
      "description": "\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05d1\u05d5\u05e1\u05d8\u05e8 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 (\u05d0\u05d7\u05d3 \u05de-11 \u05d4\u05de\u05de\u05d3\u05d9\u05dd)"
    },
    "experienced_improvement": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d7\u05e9 \u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1-7 \u05d4\u05d9\u05de\u05d9\u05dd"
    },
    "feedback_text": {
      "type": "string",
      "description": "\u05de\u05e9\u05d5\u05d1 \u05d8\u05e7\u05e1\u05d8\u05d5\u05d0\u05dc\u05d9 \u05de\u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "upgraded_to_paid": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d3\u05e8\u05d2 \u05dc\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d1\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "sent_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e9\u05db\u05d1\u05e8 \u05e0\u05e9\u05dc\u05d7\u05d5 (\u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d7\u05d6\u05e8\u05d5\u05ea)",
      "default": []
    }
  },
  "required": [
    "user_email",
    "user_name",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}