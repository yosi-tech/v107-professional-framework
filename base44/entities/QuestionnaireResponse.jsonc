{
  "name": "QuestionnaireResponse",
  "type": "object",
  "properties": {
    "personal_info": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "maxLength": 200
        },
        "age": {
          "type": "integer",
          "minimum": 16,
          "maximum": 90
        },
        "gender": {
          "type": "string",
          "enum": [
            "male",
            "female",
            "other"
          ]
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "years_of_experience": {
          "type": "string",
          "enum": [
            "0-3",
            "4-10",
            "11-20",
            "21+"
          ],
          "description": "\u05e9\u05e0\u05d5\u05ea \u05e0\u05e1\u05d9\u05d5\u05df \u05d1\u05e2\u05d1\u05d5\u05d3\u05d4"
        },
        "current_professional_status": {
          "type": "string",
          "enum": [
            "employee",
            "freelancer",
            "entrepreneur",
            "student",
            "job_seeker",
            "active_retiree"
          ],
          "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9 \u05e0\u05d5\u05db\u05d7\u05d9"
        },
        "occupation_field": {
          "type": "string",
          "enum": [
            "marketing",
            "sales",
            "hr",
            "technology",
            "entrepreneurship",
            "education",
            "management",
            "other"
          ],
          "description": "\u05ea\u05d7\u05d5\u05dd \u05e2\u05e1\u05d5\u05e7 \u05e7\u05d9\u05d9\u05dd"
        },
        "occupation_field_other": {
          "type": "string",
          "maxLength": 200,
          "description": "\u05e4\u05d9\u05e8\u05d5\u05d8 \u05ea\u05d7\u05d5\u05dd \u05e2\u05e1\u05d5\u05e7 \u05d0\u05d7\u05e8"
        },
        "interest_areas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "description": "\u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df (\u05e2\u05d3 3)"
        },
        "interest_areas_other": {
          "type": "string",
          "maxLength": 200,
          "description": "\u05e4\u05d9\u05e8\u05d5\u05d8 \u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05d7\u05e8\u05d9\u05dd"
        },
        "target_position": {
          "type": "string",
          "maxLength": 200,
          "description": "\u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d0\u05dc\u05d9\u05d5 \u05d4\u05d5\u05d2\u05e9\u05d4 \u05d4\u05de\u05d5\u05e2\u05de\u05d3\u05d5\u05ea"
        },
        "cv_file_url": {
          "type": "string",
          "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05e8\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd \u05e9\u05d4\u05d5\u05e2\u05dc\u05d5"
        },
        "cv_file_name": {
          "type": "string",
          "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5 \u05e9\u05dc \u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05d7\u05d9\u05d9\u05dd"
        }
      },
      "required": [
        "full_name",
        "email"
      ]
    },
