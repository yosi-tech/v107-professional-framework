{
  "name": "PaymentOrder",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd \u05d1\u05e9\u05e7\u05dc\u05d9\u05dd"
    },
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "full_report",
        "answers_download",
        "online_coaching_7days"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05d5\u05e6\u05e8 \u05e9\u05e0\u05e8\u05db\u05e9"
    },
    "is_express": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d5 \u05d0\u05e1\u05e4\u05e7\u05d4 \u05de\u05d5\u05d0\u05e6\u05ea"
    },
    "questionnaire_response_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05e9\u05d0\u05dc\u05d5\u05df"
    },
    "coupon_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d4\u05e7\u05d5\u05e4\u05d5\u05df \u05e9\u05d4\u05d5\u05e4\u05e2\u05dc"
    },
    "coupon_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05e7\u05d5\u05e4\u05d5\u05df"
    },
    "tranzila_reference": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05e1\u05e7\u05d4 \u05e9\u05dc \u05d8\u05e8\u05e0\u05d6\u05d9\u05dc\u05d4 (TranzilaTK)"
    },
    "confirmation_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05de\u05d8\u05e8\u05e0\u05d6\u05d9\u05dc\u05d4"
    },
    "raw_data": {
      "type": "string",
      "description": "\u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05d2\u05d5\u05dc\u05de\u05d9\u05d9\u05dd \u05de\u05d8\u05e8\u05e0\u05d6\u05d9\u05dc\u05d4 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 JSON"
    }
  },
  "required": [
    "status",
    "amount",
    "user_email",
    "product_type"
  ]
}