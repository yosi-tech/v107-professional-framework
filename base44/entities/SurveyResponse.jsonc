{
  "name": "SurveyResponse",
  "type": "object",
  "properties": {
    "survey_type": {
      "type": "string",
      "enum": [
        "abandonment",
        "feedback",
        "booster_feedback",
        "other"
      ],
      "default": "abandonment"
    },
    "responses": {
      "type": "object",
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05dc\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05e1\u05e7\u05e8"
    },
    "coupon_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d4\u05e7\u05d5\u05d5\u05e4\u05d5\u05df \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05de\u05e9\u05ea\u05de\u05e9 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e1\u05e7\u05e8"
    }
  },
  "required": [
    "survey_type",
    "responses"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}